# Vite 環境変数のサンプル
# このファイルをコピーして .env.local を作成し、値を設定してください
# Vercel ダッシュボードでは Production / Preview / Development それぞれに設定が必要
# ※ 値は src/ 内にハードコードされていないため、未設定だとアプリは起動しません

# Supabase (必須)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# 勤務表ソルバー API キー (必須)
VITE_SOLVER_API_KEY=

# 共愛会勤務表管理ポータル URL (戻るボタンの遷移先)
# admin-portal の Vercel デプロイ URL が変わった場合のみ設定
# VITE_PORTAL_URL=https://admin-portal-five-psi.vercel.app
